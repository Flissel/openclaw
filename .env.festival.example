# Festival WhatsApp Bot - Environment Configuration
# Copy to .env.festival and fill in values

# Gateway authentication token (required - generate a secure random string, e.g. `openssl rand -hex 32`)
OPENCLAW_GATEWAY_TOKEN=change-me-to-a-secure-token

# Ports (defaults shown — distinct from the hotel deployment's 18789 so both can run at once)
OPENCLAW_GATEWAY_PORT=18791

# Must match the festival website's MCP_SERVER_TOKEN env var exactly.
MCP_SERVER_TOKEN=change-me-to-match-the-festival-website

# The festival website's MCP endpoint, reachable from this container.
FESTIVAL_MCP_URL=https://<your-festival-domain>/api/mcp

# Timezone
TZ=Europe/Berlin
